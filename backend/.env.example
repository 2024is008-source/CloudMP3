# Shared secret the Worker sends as X-Api-Key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDMP3_SERVICE_KEY=

# SoundCloud API app (https://developers.soundcloud.com).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Seed refresh token from scripts/get_refresh_token.py. Once the service has
# refreshed once, the rotated token in TOKEN_STORE_PATH is authoritative.
SOUNDCLOUD_REFRESH_TOKEN=

# Where the rotated refresh token is persisted. Mount this in production.
TOKEN_STORE_PATH=./data/soundcloud-token.json

# Optional limits.
YTDLP_TIMEOUT=60
FFMPEG_TIMEOUT=300
MAX_CONVERT_BYTES=629145600
