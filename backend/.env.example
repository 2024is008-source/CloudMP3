# Shared secret the Worker sends as X-Api-Key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDMP3_SERVICE_KEY=

# SoundCloud API app (https://developers.soundcloud.com).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Seed refresh token from scripts/get_refresh_token.py. Once the service has
# refreshed once, the rotated token in TOKEN_STORE_PATH is authoritative.
SOUNDCLOUD_REFRESH_TOKEN=

# Where the rotated refresh token is persisted. Mount this in production.
TOKEN_STORE_PATH=./data/soundcloud-token.json

# Optional limits.
YTDLP_TIMEOUT=60
FFMPEG_TIMEOUT=300
MAX_CONVERT_BYTES=629145600

# Extra domains the outbound host policy may fetch audio from, comma-separated
# (e.g. cdn.example.net). sndcdn.com, soundcloud.com and soundcloud.cloud are
# always allowed; this only ever adds to that list and never relaxes https-only,
# port 443-only or the check that every DNS answer is a public address.
# Non-hostname entries are dropped. Read per request by net_guard.py, so it can
# also be exported in the shell that starts uvicorn instead of set here.
CLOUDMP3_ALLOWED_MEDIA_HOSTS=

# How many FFmpeg processes may run at once. Each WAV or MP3 conversion holds
# one slot for its whole duration, so this is the ceiling on server CPU and
# memory per download. Raise it only with matching cores and RAM.
MAX_CONCURRENT_CONVERSIONS=2

# A converted WAV or MP3 is deleted as soon as its download finishes or the
# visitor leaves. This is the backstop for files orphaned by a crash or
# restart: any temp directory idle this long is swept at startup and every 60s.
# Keep it at or above FFMPEG_TIMEOUT so a running conversion is never deleted.
TEMP_TTL_SECONDS=300

# ZIP jobs. An archive is built on disk, one track at a time, and deleted when
# the download ends or the visitor leaves; these are the ceilings on that work.
# Peak scratch space is NOT the finished archive: a job holds the growing archive
# plus the one track staged for the next copy (an original up to
# MAX_ZIP_TOTAL_BYTES, a converted file up to MAX_CONVERT_BYTES). The size limit is
# applied before each copy, so the archive itself never passes its ceiling and the
# ceiling to partition for is MAX_CONCURRENT_ZIP_JOBS x (MAX_ZIP_TOTAL_BYTES + one
# track). Measured: a 50-track job peaked at 201 MB of scratch for a 200 MB archive.
# The ZIP limit is separate from MAX_CONCURRENT_CONVERSIONS because a job spends
# its time on downloads rather than on FFmpeg.
MAX_CONCURRENT_ZIP_JOBS=2
MAX_ZIP_TRACKS=50
MAX_ZIP_TOTAL_BYTES=2147483648
ZIP_JOB_TIMEOUT_SECONDS=1800
# Where archives are staged. Empty means the system temp directory. Point it at a
# volume with room for the peak above, plus the MIN_FREE_BYTES reserve a job keeps
# back for the operating system. TEMP_TTL_SECONDS does not have to outlast
# ZIP_JOB_TIMEOUT_SECONDS: the sweep spares a directory a download is reading from
# and only reaps anything orphaned by a crash or a restart.
ZIP_TEMP_DIR=
