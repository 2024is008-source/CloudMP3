# Production build template. Copy to .env.production on the server, then build.
# Vite reads .env.production automatically for `npm run build` (mode=production).
#
# This file only carries build-time values. Runtime values (PORT, HOST,
# CLOUDMP3_SERVICE_*) belong to the process manager, not here.

# Must match the canonical host exactly: no trailing slash, no path, https.
# www.cloudmp3.site must never be canonical — Nginx 301s it to the apex, and the
# app declares canonicals from this single value.
VITE_SITE_ORIGIN=https://cloudmp3.site
