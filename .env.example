# Local development template. Copy to .env (never commit .env).
#
# Two different mechanisms read these, so where a value must be set differs:
#   build-time  VITE_*  are inlined into the bundle by Vite (this file works).
#   runtime     non-VITE_* are read from the real process environment by the
#               server. Vite does NOT put them in process.env, so export them in
#               the shell that starts `npm run dev` / `pm2 start`, not here.

# Canonical origin for canonicals, og:url, twitter:image, sitemap <loc> and
# robots.txt Sitemap. Optional in dev: unset falls back to https://cloudmp3.site.
# Only https:// origins are honoured — anything else silently falls back (see
# src/lib/site.ts), so local http:// origins cannot be tested through this file.
VITE_SITE_ORIGIN=

# Optional: the original-audio service in backend/ (yt-dlp + FFmpeg).
# Unset means the site honestly reports originals as unavailable.
#   export CLOUDMP3_SERVICE_URL=http://127.0.0.1:8090
#   export CLOUDMP3_SERVICE_KEY=<same value as backend/.env>
CLOUDMP3_SERVICE_URL=
CLOUDMP3_SERVICE_KEY=

# Optional: extra domains the outbound host policy may fetch audio, artwork and
# API answers from, comma-separated (e.g. cdn.example.net). `sndcdn.com`,
# `soundcloud.com` and `soundcloud.cloud` are always allowed; this only ever adds
# to that list and never relaxes https-only, port 443-only or the address checks.
# Entries that are not plain hostnames are dropped. Read at request time by
# src/lib/url-guard.ts, in the Node server only — a browser has no process.env,
# so client-side artwork fetches always use the shipped list.
#   export CLOUDMP3_ALLOWED_MEDIA_HOSTS=
CLOUDMP3_ALLOWED_MEDIA_HOSTS=
